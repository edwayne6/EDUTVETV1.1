<!-- Hero Section -->
<section class="bg-gradient-to-r from-blue-600 to-blue-800 text-white py-16">
  <div class="container mx-auto px-4">
    <h1 class="text-5xl font-bold mb-4">Edu-TVET</h1>
    <p class="text-xl mb-8">Empowering Learning through Quality TVET Documents</p>
    <p class="text-lg mb-8 max-w-2xl">Access comprehensive teaching resources, curriculum guides, and professional development materials for TVET institutions.</p>
    <a href="/documents" class="bg-white text-blue-600 px-8 py-3 rounded-lg font-bold hover:bg-gray-100 transition inline-block">
      <i class="fas fa-search"></i> Browse Documents
    </a>
  </div>
</section>

<!-- Features Section -->
<section class="py-16 bg-white">
  <div class="container mx-auto px-4">
    <h2 class="text-4xl font-bold text-center mb-12 text-gray-900">Why Choose EduTVET?</h2>
    
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <!-- Feature 1 -->
      <div class="text-center p-6">
        <div class="text-5xl mb-4 text-blue-600">
          <i class="fas fa-book"></i>
        </div>
        <h3 class="text-2xl font-bold mb-3 text-gray-900">Comprehensive Library</h3>
        <p class="text-gray-600">Access thousands of TVET documents covering all departments and levels.</p>
      </div>

      <!-- Feature 2 -->
      <div class="text-center p-6">
        <div class="text-5xl mb-4 text-green-600">
          <i class="fas fa-zap"></i>
        </div>
        <h3 class="text-2xl font-bold mb-3 text-gray-900">Fast & Reliable</h3>
        <p class="text-gray-600">Server-side rendering and caching ensure lightning-fast page loads.</p>
      </div>

      <!-- Feature 3 -->
      <div class="text-center p-6">
        <div class="text-5xl mb-4 text-purple-600">
          <i class="fas fa-shield-alt"></i>
        </div>
        <h3 class="text-2xl font-bold mb-3 text-gray-900">Secure & Private</h3>
        <p class="text-gray-600">Your data is protected with industry-standard security measures.</p>
      </div>
    </div>
  </div>
</section>

<!-- Departments Section -->
<section class="py-16 bg-gray-50">
  <div class="container mx-auto px-4">
    <h2 class="text-4xl font-bold text-center mb-12 text-gray-900">Explore Departments</h2>
    
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
      <% const departments = [
        { name: 'Agriculture', icon: 'leaf', color: 'green' },
        { name: 'Applied Sciences', icon: 'flask', color: 'blue' },
        { name: 'Automotive', icon: 'car', color: 'yellow' },
        { name: 'Building', icon: 'building', color: 'gray' },
        { name: 'Business', icon: 'briefcase', color: 'red' },
        { name: 'Computing', icon: 'laptop', color: 'purple' },
        { name: 'Cosmetology', icon: 'spa', color: 'pink' },
        { name: 'Electrical', icon: 'plug', color: 'orange' }
      ]; %>
      
      <% departments.forEach(dept => { %>
        <a href="/documents?department=<%= dept.name %>" class="bg-white p-6 rounded-lg shadow hover:shadow-lg transition text-center">
          <div class="text-4xl mb-3 text-<%= dept.color %>-600">
            <i class="fas fa-<%= dept.icon %>"></i>
          </div>
          <h3 class="font-bold text-gray-900"><%= dept.name %></h3>
        </a>
      <% }); %>
    </div>
  </div>
</section>

<!-- Statistics Section -->
<section class="py-16 bg-blue-600 text-white">
  <div class="container mx-auto px-4">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 text-center">
      <div>
        <div class="text-5xl font-bold mb-2">10,000+</div>
        <p class="text-xl">Documents Available</p>
      </div>
      <div>
        <div class="text-5xl font-bold mb-2">13</div>
        <p class="text-xl">Departments</p>
      </div>
      <div>
        <div class="text-5xl font-bold mb-2">50,000+</div>
        <p class="text-xl">Active Users</p>
      </div>
    </div>
  </div>
</section>

<!-- Call to Action -->
<section class="py-16 bg-white">
  <div class="container mx-auto px-4 text-center">
    <h2 class="text-4xl font-bold mb-6 text-gray-900">Ready to Get Started?</h2>
    <p class="text-xl text-gray-600 mb-8">Join thousands of educators using EduTVET for quality professional development.</p>
    <div class="flex flex-col md:flex-row gap-4 justify-center">
      <a href="/documents" class="bg-blue-600 text-white px-8 py-3 rounded-lg font-bold hover:bg-blue-700 transition">
        Browse Documents
      </a>
      <a href="/admin" class="bg-gray-200 text-gray-900 px-8 py-3 rounded-lg font-bold hover:bg-gray-300 transition">
        Admin Access
      </a>
    </div>
  </div>
</section>

<!-- Recent Documents Section (Server-Rendered) -->
<section class="py-16 bg-gray-50">
  <div class="container mx-auto px-4">
    <h2 class="text-4xl font-bold text-center mb-12 text-gray-900">Featured Documents</h2>
    
    <div id="recentDocuments" class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <!-- Will be populated by client-side JavaScript -->
      <div class="text-center col-span-full py-12">
        <p class="text-gray-500">Loading featured documents...</p>
      </div>
    </div>
  </div>
</section>

<script>
  // Load and display featured documents
  async function loadFeaturedDocuments() {
    try {
      const docs = await DocumentCache.loadDocumentsCached();
      const featured = docs.slice(0, 3);
      
      const container = document.getElementById('recentDocuments');
      container.innerHTML = '';
      
      featured.forEach(doc => {
        const card = document.createElement('div');
        card.className = 'bg-white rounded-lg shadow-md p-6 hover:shadow-lg transition';
        card.innerHTML = `
          <h3 class="text-lg font-bold mb-2 text-gray-900">${doc.title}</h3>
          <p class="text-sm text-gray-600 mb-3">${doc.department}</p>
          <p class="text-sm text-gray-500 mb-4">${new Date(doc.date).toLocaleDateString()}</p>
          <a href="/documents?search=${encodeURIComponent(doc.title)}" class="text-blue-600 hover:underline">
            View Similar →
          </a>
        `;
        container.appendChild(card);
      });
    } catch (error) {
      console.error('Failed to load featured documents:', error);
    }
  }
  
  document.addEventListener('DOMContentLoaded', loadFeaturedDocuments);
</script>

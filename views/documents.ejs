<div class="mb-8">
  <h1 class="text-4xl font-bold text-blue-900 mb-4">TVET Documents</h1>
  <p class="text-gray-600">Browse and download quality educational documents for teaching and learning</p>
</div>

<!-- Filters Section -->
<div class="bg-white p-6 rounded-lg shadow mb-8">
  <h2 class="text-xl font-bold mb-4">Filter Documents</h2>
  
  <!-- Search Box -->
  <div class="mb-4">
    <input type="text" id="searchInput" placeholder="Search documents..." 
           class="w-full px-4 py-2 border-2 border-gray-300 rounded-lg focus:border-blue-500 focus:outline-none">
  </div>

  <!-- Filter Buttons -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
    <!-- Department Filter -->
    <div>
      <label class="font-semibold text-gray-700 mb-2 block">Department</label>
      <select id="departmentFilter" class="w-full px-4 py-2 border-2 border-gray-300 rounded-lg">
        <option value="">All Departments</option>
        <% departments.forEach(dept => { %>
          <option value="<%= dept %>"><%= dept %></option>
        <% }); %>
      </select>
    </div>

    <!-- Document Type Filter -->
    <div>
      <label class="font-semibold text-gray-700 mb-2 block">Document Type</label>
      <select id="typeFilter" class="w-full px-4 py-2 border-2 border-gray-300 rounded-lg">
        <option value="">All Types</option>
        <option value="Notes">Notes</option>
        <option value="Curriculum">Curriculum</option>
        <option value="Occupational Standards">Standards</option>
        <option value="Planning Documents">Planning</option>
      </select>
    </div>

    <!-- Level Filter -->
    <div>
      <label class="font-semibold text-gray-700 mb-2 block">Level</label>
      <select id="levelFilter" class="w-full px-4 py-2 border-2 border-gray-300 rounded-lg">
        <option value="">All Levels</option>
        <option value="Level 3">Level 3</option>
        <option value="Level 4">Level 4</option>
        <option value="Level 5">Level 5</option>
        <option value="Level 6">Level 6</option>
      </select>
    </div>
  </div>
</div>

<!-- Documents Grid -->
<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
  <% if (documents && documents.length > 0) { %>
    <% documents.forEach(doc => { %>
      <div class="document-card bg-white rounded-lg shadow-md overflow-hidden hover:shadow-lg transition">
        <div class="p-6">
          <!-- Document Header -->
          <div class="mb-3">
            <h3 class="text-lg font-bold text-gray-900 mb-2"><%= doc.title %></h3>
            <div class="flex flex-wrap gap-2 mb-3">
              <span class="badge bg-blue-100 text-blue-800 px-3 py-1 rounded text-sm">
                <i class="fas fa-folder"></i> <%= doc.department %>
              </span>
              <span class="badge bg-green-100 text-green-800 px-3 py-1 rounded text-sm">
                <%= doc.docType %>
              </span>
              <span class="badge bg-purple-100 text-purple-800 px-3 py-1 rounded text-sm">
                <%= doc.level %>
              </span>
            </div>
          </div>

          <!-- Description -->
          <p class="text-gray-600 text-sm mb-4 line-clamp-2">
            <%= doc.description || 'No description available' %>
          </p>

          <!-- Meta Information -->
          <div class="text-sm text-gray-500 mb-4">
            <p>
              <i class="fas fa-calendar"></i> <%= new Date(doc.date).toLocaleDateString() %>
            </p>
            <p>
              <i class="fas fa-user"></i> <%= doc.submittedBy || 'System' %>
            </p>
          </div>

          <!-- Download Button -->
          <button onclick="handleDownload('<%= doc.id %>')" 
                  class="w-full bg-blue-600 text-white py-2 rounded hover:bg-blue-700 transition">
            <i class="fas fa-download"></i> Download
          </button>
        </div>
      </div>
    <% }); %>
  <% } else { %>
    <div class="col-span-full text-center py-12">
      <i class="fas fa-inbox text-6xl text-gray-300 mb-4"></i>
      <h3 class="text-2xl font-bold text-gray-500 mb-2">No documents found</h3>
      <p class="text-gray-400">Try adjusting your filters or search terms</p>
    </div>
  <% } %>
</div>

<!-- Results Counter -->
<div class="mt-8 text-center text-gray-600">
  <p>Showing <span id="resultCount"><%= documents ? documents.length : 0 %></span> documents</p>
</div>

<!-- Client-side Script for Filtering and Interactivity -->
<script src="/scripts/document-cache.js"><\/script>
<script>
  // Load documents from cache or server
  async function initializeDocuments() {
    try {
      const allDocs = await DocumentCache.loadDocumentsCached();
      setupFilters(allDocs);
    } catch (error) {
      console.error('Failed to load documents:', error);
    }
  }

  function setupFilters(docs) {
    const searchInput = document.getElementById('searchInput');
    const deptFilter = document.getElementById('departmentFilter');
    const typeFilter = document.getElementById('typeFilter');
    const levelFilter = document.getElementById('levelFilter');

    function filterDocuments() {
      const query = searchInput.value.toLowerCase();
      const dept = deptFilter.value;
      const type = typeFilter.value;
      const level = levelFilter.value;

      const filtered = docs.filter(doc => {
        const matchesSearch = !query || 
          doc.title.toLowerCase().includes(query) || 
          doc.description.toLowerCase().includes(query);
        const matchesDept = !dept || doc.department === dept;
        const matchesType = !type || doc.docType === type;
        const matchesLevel = !level || doc.level === level;

        return matchesSearch && matchesDept && matchesType && matchesLevel;
      });

      document.getElementById('resultCount').textContent = filtered.length;
      console.log(`Filtered to ${filtered.length} documents`);
    }

    // Add event listeners
    searchInput.addEventListener('input', filterDocuments);
    deptFilter.addEventListener('change', filterDocuments);
    typeFilter.addEventListener('change', filterDocuments);
    levelFilter.addEventListener('change', filterDocuments);
  }

  function handleDownload(docId) {
    // Redirect to download endpoint
    window.location.href = `/api/documents/${docId}/download`;
  }

  // Initialize on page load
  document.addEventListener('DOMContentLoaded', initializeDocuments);
<\/script>

# Server Configuration
PORT=5000
NODE_ENV=development
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Email Configuration (for automated notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=edutvet1@gmail.com
SMTP_PASS=your-gmail-app-password-here

# Admin Email Addresses (comma-separated for multiple admins)
ADMIN_EMAILS=edutvet1@gmail.com,admin@edutvet.com

# Frontend URLs (for email links)
FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:3000/admin.html

